# SearXNG
SEARXNG_URL=http://localhost:8080

# MCP transport
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9000

# Media processing
MEDIA_TEMP_DIR=/tmp/mcp-media
MAX_VIDEO_SECONDS=120
FRAME_EVERY_SECONDS=3

# Whisper
WHISPER_MODEL=small
WHISPER_CPP_BIN=whisper-cli
# WHISPER_MODEL_PATH=~/.cache/whisper-cpp/ggml-small.bin

# Fetch
MAX_FETCH_SIZE_MB=10
FETCH_TIMEOUT_SECONDS=30
